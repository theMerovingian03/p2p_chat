{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "P2P Chat",
  "version": "0.1.0",
  "identifier": "com.p2pchat.tauri",
  "build": {
    "beforeDevCommand": "deno task dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "P2P Chat",
        "decorations": false,
        "width": 1440,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}